---
// A project's page: its narrative, then "In the family" and, last, "In the
// timeline". When the stage runs, the page slides in beside the emblem as it
// blooms into the project's colours.
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FamilyList from '../../../components/FamilyList.astro';
import ProjectName from '../../../components/ProjectName.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import TimelineWheel from '../../../components/TimelineWheel.svelte';
import { monthYear } from '../../../lib/dates';
import { narrative } from '../../../lib/narrative';
import { familyOf, kicker, timeline, type Project } from '../../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const [family, story, rows] = await Promise.all([
  familyOf(project),
  narrative(project),
  timeline(),
]);
const here = rows.findIndex((r) => r.slug === project.id);
const wheel = rows.map((r) => ({ ...r, key: r.slug, current: r.slug === project.id }));
const open = data.name.includes(' ') ? 'Open the site' : `Open ${data.name}`;
---

<BaseLayout
  view="project"
  slug={project.id}
  title={data.name}
  description={data.line}
  footer={false}
>
  <a class="back" href="/">
    ← All projects
  </a>
  <article class="panel" id="panel" aria-labelledby="project-name">
    <header class="project-head">
      <p class="kick">{kicker(project, family.data.name, monthYear(data.started))}</p>
      <h1 class="pname" id="project-name">
        <ProjectName project={project} />
      </h1>
      <p class="roots">
        {data.roots[0]} + {data.roots[1]}
      </p>
      <p class="lede">{data.line}</p>
      <div class="ctas">
        <a class="btn primary" href={data.url}>
          {open} ↗
        </a>
        <a class="btn" href={data.repo}>
          Source
        </a>
      </div>
    </header>

    <section class="sec">
      <h2>The idea</h2>
      <Fragment set:html={story.idea} />
    </section>
    <section class="sec">
      <h2>The story</h2>
      <Fragment set:html={story.story} />
    </section>
    <section class="sec">
      <h2>The challenges</h2>
      <div class="chal">
        <Fragment set:html={story.challenges} />
      </div>
    </section>
    <section class="sec">
      <h2>In short</h2>
      <dl class="facts">
        {data.title && (
          <>
            <dt>Also known as</dt>
            <dd>{data.title}</dd>
          </>
        )}
        <dt>Special</dt>
        <dd set:html={story.special} />
        <dt>Built with</dt>
        <dd set:html={story.stack} />
        {story.figures && (
          <>
            <dt>Figures</dt>
            <dd set:html={story.figures} />
          </>
        )}
        <dt>Since</dt>
        <dd>{monthYear(data.started)}</dd>
      </dl>
      {data.made && <p class="made">Made with ♥ {data.made}.</p>}
      {data.notice && <p class="notice">{data.notice}</p>}
    </section>

    <FamilyList project={project} />

    <section class="sec timeline" aria-labelledby="timeline">
      <h2 id="timeline">In the timeline</h2>
      <p class="sub">Every project, in the order it began. Turn the wheel to travel in time.</p>
      <TimelineWheel
        client:visible
        rows={wheel}
        start={here}
        label={`My projects in time, ${data.name} in front`}
        backLabel={`Back to ${data.name}`}
      />
    </section>
    <SiteFooter />
  </article>
</BaseLayout>
