---
// The home. As plain HTML it is the line and every project as a list; when
// the stage runs it becomes Converge: the list turns into a rail of names, and
// each project's name rides two drops that fuse and pour into its emblem.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectName from '../components/ProjectName.astro';
import { SITE } from '../config/site';
import { yearOf } from '../lib/dates';
import { familyNames, kicker, projectPath, projectsForHome, splitName } from '../lib/projects';

const projects = await projectsForHome();
const families = await familyNames();
const first = projects[0]!;
const [firstA, firstB] = splitName(first);
const familyOf = (p: (typeof projects)[number]) => families.get(p.data.family.id) ?? '';
---

<BaseLayout view="home">
  <section class="home-hero">
    <h1>{SITE.line}</h1>
  </section>

  <div class="converge">
    <span class="word" id="converge-wa" aria-hidden="true">
      {first.data.roots[0]}
    </span>
    <span class="word" id="converge-wb" aria-hidden="true">
      {first.data.roots[1]}
    </span>
    <div class="converge-mark" id="converge-mark" aria-hidden="true">
      <p class="roots" id="converge-roots">
        {first.data.roots[0]} + {first.data.roots[1]}
      </p>
      <p class="converge-name" id="converge-name">
        <span>{firstA}</span>
        <i class="mercury-dot"></i>
        <span>{firstB}</span>
      </p>
    </div>
    <div class="converge-foot">
      <div>
        <p class="converge-line">
          <b id="converge-kicker">{kicker(first, familyOf(first), yearOf(first.data.started))}</b>
          <span id="converge-line">{first.data.line}</span>
        </p>
        <p class="converge-made" id="converge-made">
          {first.data.made && `Made with ♥ ${first.data.made}.`}
        </p>
      </div>
      <a class="converge-cta" id="converge-cta" href={projectPath(first)}>
        Open the project →
      </a>
    </div>
  </div>

  <nav class="home-index" aria-labelledby="projects">
    <h2 id="projects">Projects</h2>
    <ol id="home-index">
      {projects.map((project) => (
        <li>
          <a href={projectPath(project)} data-slug={project.id}>
            <span class="n">
              <ProjectName project={project} />
            </span>
            <span class="about">
              <span class="k">
                {kicker(project, familyOf(project), yearOf(project.data.started))}
              </span>
              <span class="l">{project.data.line}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</BaseLayout>
