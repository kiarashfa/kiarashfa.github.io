---
// GitHub Pages serves /404.html for any address it cannot resolve on this
// domain, so the page must be complete in its own HTML and link from the root.
// The timeline wheel turns as a ring here, with an empty stop in its lens,
// placed in the longest quiet stretch between two projects.
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineWheel, { type WheelRow } from '../components/TimelineWheel.svelte';
import { timeline } from '../lib/projects';

const time = await timeline();
// the row that follows the longest gap (or the end, when there is none)
let quiet = time.length;
for (let i = 0, longest = 0; i < time.length; i++)
  if (time[i]!.gap > longest) [quiet, longest] = [i, time[i]!.gap];

const rows: WheelRow[] = time.map((r) => ({ ...r, key: r.slug, gap: 0 }));
rows.splice(quiet, 0, {
  key: 'empty',
  name: 'Not found',
  family: 'This address',
  month: '— —',
  year: '404',
  empty: true,
});
---

<BaseLayout title="Not found" description="There is no page at this address." noindex>
  <div class="page not-found">
    <div class="not-found-text">
      <p class="kick">404 · Not found</p>
      <h1>Not in the timeline</h1>
      <p class="quip">Nothing began at this address. Turn the wheel to something that did.</p>
      <nav class="ways" aria-label="Ways out">
        <a href="/">Home</a>
        <a href="/me/">About me</a>
      </nav>
    </div>
    <TimelineWheel
      client:load
      rows={rows}
      start={quiet}
      loop
      label="Every project, in the order it began"
    />
  </div>
</BaseLayout>
