---
// GitHub Pages serves /404.html for any address it cannot resolve on this
// domain, so the page must be complete in its own HTML and link from the root.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="There is no page at this address." noindex>
  <section class="mx-auto grid max-w-2xl justify-items-center px-4 pt-24 text-center sm:pt-32">
    <p class="text-[13px] tracking-[0.34em] text-ink-faint tabular-nums">404</p>
    <h1 class="mt-4 font-display text-5xl font-normal sm:text-6xl">Not found</h1>
    <p class="mt-4 text-lg text-ink-dim">There is no page at this address.</p>
    <nav
      class="mt-10 flex w-full flex-wrap justify-center gap-x-7 gap-y-2.5 border-t border-hair pt-8"
      aria-label="Ways out"
    >
      <a href="/" class="font-display text-lg">
        Home
      </a>
      <a href="/me/" class="font-display text-lg">
        About
      </a>
    </nav>
  </section>
</BaseLayout>
